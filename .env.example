# Public leads endpoint for AI training registrations from JantaHR OPs.
# Example: https://qjsgqskigjqrzjftunhg.supabase.co/functions/v1/public-leads
VITE_AI_TRAINING_REGISTRATION_ENDPOINT=

# Contact form endpoint: JantaHR OPs public-leads (defaults to it if unset).
# Example: https://qjsgqskigjqrzjftunhg.supabase.co/functions/v1/public-leads
VITE_CONTACT_ENDPOINT=

# Public website URL used for canonical/OG metadata.
VITE_SITE_URL=https://jantahr.netlify.app

# Public jobs endpoint from JantaHR OPs (defaults to /data/jobs.json if unset)
# Example: https://qjsgqskigjqrzjftunhg.supabase.co/functions/v1/public-jobs
VITE_JOBS_ENDPOINT=

# Candidate registration endpoint from JantaHR OPs (leave empty to show email fallback)
# Example: https://qjsgqskigjqrzjftunhg.supabase.co/functions/v1/public-candidates
VITE_CANDIDATE_ENDPOINT=

