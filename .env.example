# Public leads relay endpoint for AI training registrations.
# Example:
# VITE_AI_TRAINING_REGISTRATION_ENDPOINT=https://janta-internal-system.vercel.app/api/integrations/public-leads
# Google Sheets option:
# VITE_AI_TRAINING_REGISTRATION_ENDPOINT=https://script.google.com/macros/s/XXXX/exec
VITE_AI_TRAINING_REGISTRATION_ENDPOINT=

# Optional jobs endpoint.
# If empty, the site loads jobs from /public/data/jobs.json
# Example:
# VITE_JOBS_ENDPOINT=https://api.example.com/jobs
VITE_JOBS_ENDPOINT=

# Public website URL used for canonical/OG metadata.
# Example:
# VITE_SITE_URL=https://jantahr.netlify.app
VITE_SITE_URL=

# Google Form prefill settings for job applications.
# "Role you are applying for" should map to VITE_GOOGLE_FORM_ROLE_TITLE_KEY.
# Example:
# VITE_GOOGLE_FORM_BASE_URL=https://docs.google.com/forms/d/e/FORM_ID/viewform
# VITE_GOOGLE_FORM_ROLE_TITLE_KEY=entry.1111111111
# VITE_GOOGLE_FORM_ROLE_SLUG_KEY=entry.2222222222
# VITE_GOOGLE_FORM_COMPANY_KEY=entry.3333333333
# VITE_GOOGLE_FORM_SOURCE_PAGE_KEY=entry.4444444444
# VITE_GOOGLE_FORM_JOB_ID_KEY=entry.5555555555
VITE_GOOGLE_FORM_BASE_URL=
VITE_GOOGLE_FORM_ROLE_TITLE_KEY=
VITE_GOOGLE_FORM_ROLE_SLUG_KEY=
VITE_GOOGLE_FORM_COMPANY_KEY=
VITE_GOOGLE_FORM_SOURCE_PAGE_KEY=
VITE_GOOGLE_FORM_JOB_ID_KEY=
